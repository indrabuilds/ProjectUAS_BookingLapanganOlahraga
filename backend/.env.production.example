APP_NAME=SportsCourt
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Akun database khusus aplikasi. Jangan pakai root, dan jangan tinggalkan password kosong.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportscourt
DB_USERNAME=sportscourt
DB_PASSWORD=ganti-dengan-password-database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Titik di depan supaya cookie berlaku untuk app.example.com dan api.example.com.
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Host halaman yang boleh membawa cookie. Tanpa https:// dan tanpa garis miring di akhir.
SANCTUM_STATEFUL_DOMAINS=app.example.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BOOKING_PENDING_TTL_MINUTES=120
BOOKING_CANCEL_CUTOFF_HOURS=24
BOOKING_MAX_DAYS_AHEAD=30
